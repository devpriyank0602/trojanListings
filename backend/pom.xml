<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.ebay</groupId>
  <artifactId>trojan-listings</artifactId>
  <version>0.1.0</version>
  <name>trojan-listings</name>
  <description>Listing-borne prompt injection measurement and defence</description>

  <properties>
    <java.version>17</java.version>
    <onnxruntime.version>1.19.2</onnxruntime.version>
    <djl.tokenizers.version>0.30.0</djl.tokenizers.version>
    <tess4j.version>5.11.0</tess4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      ONNX Runtime is the inference engine. This follows the established internal
      pattern (nsfw-classifier-server, cpcguidesvc, HomeSplice) of embedding ORT in
      the Java service rather than calling an inference endpoint. See research.md §2.

      NOTE: ai.djl.onnxruntime:onnxruntime-engine is deliberately NOT a dependency.
      DJL is used for tokenization only.
    -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>${onnxruntime.version}</version>
    </dependency>

    <!-- Tokenizer only. Reads tokenizer.json directly via the Rust tokenizers JNI. -->
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
      <version>${djl.tokenizers.version}</version>
    </dependency>

    <!--
      OCR for in-image attacks is done by shelling out to the Tesseract CLI, not via
      the Tess4J JNA bindings. Tess4J 5.11.0 ships darwin-x86-64 natives only, so it
      fails with UnsatisfiedLinkError on Apple Silicon. research.md section 3 named the
      CLI as the documented fallback; it is now the primary path and needs no
      dependency at all. Install with: brew install tesseract
    -->


    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
